# ==============================================================================
# COUNSELLING MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file to .env for local development or configure these variables
# directly in AWS Secrets Manager / AWS App Runner / ECS Environment Variables.
# NEVER commit production credentials to git.
# ==============================================================================

# 1. APPLICATION RUNTIME ENVIRONMENT
NODE_ENV=production
PORT=5000

# 2. DOMAIN & CORS CONFIGURATION
# Production Frontend URL (Custom Domain)
FRONTEND_URL=https://verdantmind.com
# Production Backend API URL
BACKEND_URL=https://api.verdantmind.com
API_URL=https://api.verdantmind.com

# 3. DATABASE CONFIGURATION
# MongoDB Atlas Primary Connection String (Recommended AWS Mumbai: ap-south-1)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/counselling_portal?retryWrites=true&w=majority&appName=counselling

# 4. SERVER SESSION & SECURITY
# Strong random 64-character secret for cryptographic session cookie signing
SESSION_SECRET=generate_with_openssl_rand_hex_32

# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# Generated via Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Must match Authorized Redirect URIs in Google Cloud Console
GOOGLE_CALLBACK_URL=https://api.verdantmind.com/api/auth/google/callback

# 6. INITIAL SUPER ADMIN BOOTSTRAP EMAIL
# The first account authorized as Super Admin with full management privileges
BOOTSTRAP_ADMIN_EMAIL=sabujd880@gmail.com

# 7. AWS S3 PRIVATE RECORDINGS STORAGE (AWS MUMBAI: ap-south-1)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=counselling-recordings-private-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 8. TRANSACTIONAL EMAIL (BREVO SMTP)
BREVO_API_KEY=xkeysib-YOUR_BREVO_KEY
SENDER_EMAIL=sabujd880@gmail.com
SENDER_NAME="Sabuj Das | Verdant Mind Care"

# 9. AI CLINICAL TOOLS (GOOGLE GEMINI FLASH & MONGODB ATLAS AI)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
MONGODB_MODEL_API_KEY=al-YOUR_MONGODB_MODEL_API_KEY
MONGODB_MODEL_ENDPOINT=https://ai.mongodb.com/v1

# 10. LEGACY PROVIDER FALLBACK CREDENTIALS (PRESERVED)
PROVIDER_EMAIL=sabuj.admin@counseling.com
PROVIDER_PHONE=9547691433
PROVIDER_PASSWORD=SabujCare#2026!

