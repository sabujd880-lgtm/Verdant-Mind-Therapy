  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "build:start": "npm run build && node --dns-result-order=ipv4first server.js",
    "dev": "concurrently \"vite\" \"node server.js\"",
    "vite": "vite",
    "server": "node server.js",
    "dev:all": "concurrently \"vite\" \"nodemon server.js\"",
    "all": "npm run dev:all",
