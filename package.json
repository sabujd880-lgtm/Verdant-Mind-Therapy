    "lint": "oxlint",
    "generate:favicons": "node scripts/generate-favicons.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@vitejs/plugin-react": "^6.0.3",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.24.0",
    "mongoose": "^9.7.4",
    "multer": "^2.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
